# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 运行时数据库
*.db
*.sqlite3
*.sqlite

# 日志与运行输出
*.log
*.out

# 测试 / 探测临时产物（不要入库）
probe_result.txt
*_test_log.txt
api_auth_test_results.json
*.tmp

# 本机个人配置 / 密钥模板 / 运行时状态 / 备份（不要入库）
config.yaml
data/runtime.json
*.bak

# Python 代码执行通道留档（py_exec）
# 每段执行过的代码按 data/scripts/exec/<目标域名>/exec_<时间戳>.py 留档，
# 目录名本身即目标、代码内可能含 payload/凭据。仓库为 public，必须排除。
data/scripts/
